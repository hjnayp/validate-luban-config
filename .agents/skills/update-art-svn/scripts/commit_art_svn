#!/usr/bin/env bash
# ============================================================
# commit_art_svn — 提交美术 SVN 仓库变更
# 用法: commit_art_svn <提交信息> [子目录路径]
#   commit_art_svn "修复角色立绘"          → 提交整个 art 目录的变更
#   commit_art_svn "更新 FGUI 工程" dist   → 仅提交 art/dist 下的变更
# ============================================================

set -euo pipefail

# ---- 常量 ----
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../../../../" && pwd)"
readonly ART_ROOT="${PROJECT_ROOT}/../../art"
readonly LOG_FILE="/tmp/commit_art_svn_$(date +%Y%m%d_%H%M%S).log"

# ---- 颜色输出（兼容无 tput 环境） ----
if command -v tput &>/dev/null && [ -t 1 ]; then
    readonly C_GREEN="$(tput setaf 2)"
    readonly C_RED="$(tput setaf 1)"
    readonly C_YELLOW="$(tput setaf 3)"
    readonly C_CYAN="$(tput setaf 6)"
    readonly C_BOLD="$(tput bold)"
    readonly C_RESET="$(tput sgr0)"
else
    readonly C_GREEN="" C_RED="" C_YELLOW="" C_CYAN="" C_BOLD="" C_RESET=""
fi

# ---- 工具函数 ----
log_info()  { echo "${C_CYAN}[INFO]${C_RESET}  $*"; }
log_ok()    { echo "${C_GREEN}[OK]${C_RESET}    $*"; }
log_warn()  { echo "${C_YELLOW}[WARN]${C_RESET}  $*"; }
log_error() { echo "${C_RED}[ERROR]${C_RESET} $*" >&2; }

# ---- 前置检查 ----
preflight_check() {
    if ! command -v svn &>/dev/null; then
        log_error "未找到 svn 命令，请先安装 Subversion"
        log_info  "  macOS:  brew install subversion"
        log_info  "  Linux:  sudo apt install subversion  /  sudo yum install subversion"
        exit 1
    fi

    if [ ! -d "${ART_ROOT}" ]; then
        log_error "美术仓库目录不存在: ${ART_ROOT}"
        log_info  "请确认项目目录结构: work-project-02/art 应与 client 目录同级"
        exit 1
    fi

    if [ ! -d "${ART_ROOT}/.svn" ]; then
        log_error "目标目录不是 SVN 工作副本: ${ART_ROOT}"
        exit 1
    fi
}

# ---- 解析目标路径（结果存入全局变量 RESOLVED_TARGET） ----
resolve_target_path() {
    local sub_dir="${1:-}"
    RESOLVED_TARGET="${ART_ROOT}"

    if [ -n "${sub_dir}" ]; then
        RESOLVED_TARGET="${ART_ROOT}/${sub_dir}"
        if [ ! -d "${RESOLVED_TARGET}" ]; then
            log_error "子目录不存在: ${RESOLVED_TARGET}"
            log_info  "可用子目录:"
            for d in "${ART_ROOT}"/*/; do
                [ -d "${d}" ] && echo "  - $(basename "${d}")"
            done
            exit 1
        fi
    fi
}

# ---- 收集变更状态（结果存入全局数组） ----
# svn status 标记说明:
#   ? = 未版本控制   A = 已添加   M = 已修改   D = 已删除
#   C = 冲突         ! = 缺失     ~ = 类型变更
UNVERSIONED_FILES=()
MODIFIED_FILES=()
ADDED_FILES=()
DELETED_FILES=()
CONFLICTED_FILES=()
MISSING_FILES=()
OTHER_FILES=()

collect_changes() {
    local target="$1"

    # 重置全局数组
    UNVERSIONED_FILES=()
    MODIFIED_FILES=()
    ADDED_FILES=()
    DELETED_FILES=()
    CONFLICTED_FILES=()
    MISSING_FILES=()
    OTHER_FILES=()

    local status_output
    status_output="$(svn status "${target}" 2>/dev/null)" || {
        log_error "无法获取 SVN 状态信息"
        exit 1
    }

    if [ -z "${status_output}" ]; then
        return 0
    fi

    while IFS= read -r line; do
        local flag="${line:0:1}"
        local file_path="${line:8}"
        case "${flag}" in
            '?') UNVERSIONED_FILES+=("${file_path}") ;;
            'M') MODIFIED_FILES+=("${file_path}") ;;
            'A') ADDED_FILES+=("${file_path}") ;;
            'D') DELETED_FILES+=("${file_path}") ;;
            'C') CONFLICTED_FILES+=("${file_path}") ;;
            '!') MISSING_FILES+=("${file_path}") ;;
            *)   OTHER_FILES+=("${line}") ;;
        esac
    done <<< "${status_output}"
}

# ---- 展示变更摘要 ----
show_changes_summary() {
    local total=$(( ${#MODIFIED_FILES[@]} + ${#ADDED_FILES[@]} + ${#DELETED_FILES[@]} + ${#UNVERSIONED_FILES[@]} + ${#MISSING_FILES[@]} + ${#CONFLICTED_FILES[@]} ))

    if [ "${total}" -eq 0 ] && [ "${#OTHER_FILES[@]}" -eq 0 ]; then
        log_info "没有检测到任何变更，无需提交"
        return 1
    fi

    log_info "${C_BOLD}变更摘要:${C_RESET}"

    # 已修改
    if [ "${#MODIFIED_FILES[@]}" -gt 0 ]; then
        echo "  ${C_YELLOW}M 已修改 (${#MODIFIED_FILES[@]})${C_RESET}"
        print_file_list "${MODIFIED_FILES[@]}"
    fi

    # 已添加（svn add 过的）
    if [ "${#ADDED_FILES[@]}" -gt 0 ]; then
        echo "  ${C_GREEN}A 已添加 (${#ADDED_FILES[@]})${C_RESET}"
        print_file_list "${ADDED_FILES[@]}"
    fi

    # 已删除
    if [ "${#DELETED_FILES[@]}" -gt 0 ]; then
        echo "  ${C_RED}D 已删除 (${#DELETED_FILES[@]})${C_RESET}"
        print_file_list "${DELETED_FILES[@]}"
    fi

    # 未版本控制（新文件，需要 svn add）
    if [ "${#UNVERSIONED_FILES[@]}" -gt 0 ]; then
        echo "  ${C_CYAN}? 未版本控制 (${#UNVERSIONED_FILES[@]})${C_RESET}"
        print_file_list "${UNVERSIONED_FILES[@]}"
    fi

    # 缺失文件（本地已删但未 svn delete）
    if [ "${#MISSING_FILES[@]}" -gt 0 ]; then
        echo "  ${C_RED}! 缺失 (${#MISSING_FILES[@]})${C_RESET}"
        print_file_list "${MISSING_FILES[@]}"
    fi

    # 冲突
    if [ "${#CONFLICTED_FILES[@]}" -gt 0 ]; then
        echo "  ${C_RED}C 冲突 (${#CONFLICTED_FILES[@]})${C_RESET}"
        print_file_list "${CONFLICTED_FILES[@]}"
    fi

    echo ""
    return 0
}

# ---- 文件列表打印（超过阈值时折叠） ----
readonly MAX_DISPLAY_FILES=10

print_file_list() {
    local files=("$@")
    local count="${#files[@]}"

    if [ "${count}" -le "${MAX_DISPLAY_FILES}" ]; then
        for f in "${files[@]}"; do
            echo "    ${f}"
        done
    else
        # 只展示前几个和后几个
        local head_count=5
        local tail_count=3
        for (( i=0; i<head_count; i++ )); do
            echo "    ${files[$i]}"
        done
        echo "    ... 省略 $(( count - head_count - tail_count )) 个文件 ..."
        for (( i=count-tail_count; i<count; i++ )); do
            echo "    ${files[$i]}"
        done
    fi
}

# ---- 自动处理未版本控制和缺失文件 ----
auto_stage_changes() {
    local staged_add=0
    local staged_del=0

    # 自动 svn add 未版本控制的文件
    if [ "${#UNVERSIONED_FILES[@]}" -gt 0 ]; then
        log_info "自动执行 svn add (${#UNVERSIONED_FILES[@]} 个新文件) ..."
        for f in "${UNVERSIONED_FILES[@]}"; do
            svn add "${f}" >> "${LOG_FILE}" 2>&1
            staged_add=$(( staged_add + 1 ))
        done
        log_ok "已添加 ${staged_add} 个新文件"
    fi

    # 自动 svn delete 缺失的文件
    if [ "${#MISSING_FILES[@]}" -gt 0 ]; then
        log_info "自动执行 svn delete (${#MISSING_FILES[@]} 个缺失文件) ..."
        for f in "${MISSING_FILES[@]}"; do
            svn delete "${f}" >> "${LOG_FILE}" 2>&1
            staged_del=$(( staged_del + 1 ))
        done
        log_ok "已删除 ${staged_del} 个缺失文件"
    fi
}

# ---- 冲突检查 ----
check_conflicts() {
    if [ "${#CONFLICTED_FILES[@]}" -gt 0 ]; then
        log_error "检测到 ${#CONFLICTED_FILES[@]} 个冲突文件，无法提交"
        log_info  "请先手动解决冲突后重试:"
        for f in "${CONFLICTED_FILES[@]}"; do
            echo "  ${C_RED}C${C_RESET} ${f}"
        done
        exit 1
    fi
}

# ---- 执行提交 ----
do_commit() {
    local target="$1"
    local message="$2"

    log_info "正在执行 svn commit ..."
    log_info "提交信息: ${C_BOLD}${message}${C_RESET}"
    log_info "日志文件: ${LOG_FILE}"
    echo ""

    local exit_code=0
    svn commit "${target}" -m "${message}" 2>&1 | tee -a "${LOG_FILE}" || exit_code=$?

    echo ""

    if [ "${exit_code}" -ne 0 ]; then
        log_error "svn commit 失败 (exit code: ${exit_code})"
        log_error "请检查日志: ${LOG_FILE}"

        if grep -qi "conflict" "${LOG_FILE}"; then
            log_warn "检测到冲突，请手动解决后重试"
        fi
        if grep -qi "out of date\|needs update" "${LOG_FILE}"; then
            log_warn "工作副本不是最新版本，请先执行 update_art_svn 后重试"
        fi
        if grep -qi "authorization failed\|authentication" "${LOG_FILE}"; then
            log_warn "认证失败，请检查 SVN 凭据"
        fi
        if grep -qi "unable to connect\|connection refused" "${LOG_FILE}"; then
            log_warn "网络连接失败，请检查 VPN 或网络状态"
        fi

        exit "${exit_code}"
    fi
}

# ---- 显示提交后状态 ----
show_post_commit_info() {
    local target="$1"

    local new_rev
    new_rev="$(svn info "${target}" 2>/dev/null | grep '^Revision:' | awk '{print $2}')"

    # 从日志中提取已提交的版本号
    local committed_rev
    committed_rev="$(grep -o 'Committed revision [0-9]*' "${LOG_FILE}" 2>/dev/null | awk '{print $3}')" || true
    committed_rev="${committed_rev:-${new_rev}}"

    log_ok "提交完成"
    log_info "提交版本: r${committed_rev}"
    log_info "日志路径: ${LOG_FILE}"
}

# ---- 主流程 ----
main() {
    local commit_message="${1:-}"
    local sub_dir="${2:-}"

    echo ""
    log_info "========== 提交美术 SVN 仓库 =========="
    echo ""

    # 校验提交信息
    if [ -z "${commit_message}" ]; then
        log_error "缺少提交信息"
        log_info  "用法: commit_art_svn <提交信息> [子目录路径]"
        log_info  "示例: commit_art_svn \"修复角色立绘尺寸\""
        log_info  "示例: commit_art_svn \"更新 FGUI 工程\" dist"
        exit 1
    fi

    preflight_check

    resolve_target_path "${sub_dir}"
    local target="${RESOLVED_TARGET}"

    log_info "目标路径: ${target}"

    local repo_url
    repo_url="$(svn info "${target}" 2>/dev/null | grep '^URL:' | awk '{print $2}')"
    log_info "仓库地址: ${repo_url}"

    local current_rev
    current_rev="$(svn info "${target}" 2>/dev/null | grep '^Revision:' | awk '{print $2}')"
    log_info "当前版本: r${current_rev}"
    echo ""

    # 收集并展示变更
    collect_changes "${target}"

    if ! show_changes_summary; then
        echo ""
        log_ok "无变更，跳过提交 ✅"
        echo ""
        exit 0
    fi

    # 冲突文件阻断提交
    check_conflicts

    # 自动 stage 新文件和缺失文件
    auto_stage_changes

    echo ""

    # 执行提交
    do_commit "${target}" "${commit_message}"

    # 展示结果
    show_post_commit_info "${target}"

    echo ""
    log_ok "全部完成 ✅"
    echo ""
}

main "$@"

